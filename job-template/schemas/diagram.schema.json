{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "title",
    "nodes"
  ],
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "flow",
        "concept-map",
        "hierarchy",
        "timeline",
        "comparison",
        "cycle",
        "process",
        "network",
        "matrix"
      ]
    },
    "title": {
      "type": "string",
      "maxLength": 200
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "[a-zA-Z][a-zA-Z0-9_-]*"
          },
          "label": {
            "type": "string",
            "maxLength": 120
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "label": {
            "type": "string",
            "maxLength": 35
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BookOrder Diagram IR"
}
