{
  "type": "object",
  "required": ["schema", "style_id", "genre", "inputs_fingerprint", "summary", "checks", "measurement", "scope_note"],
  "properties": {
    "schema": {"type": "string", "enum": ["bookorder/art-direction-check@1"]},
    "style_id": {"type": "string"},
    "genre": {"type": "string"},
    "inputs_fingerprint": {"type": "string"},
    "summary": {
      "type": "object",
      "required": ["status", "low", "medium", "high"],
      "properties": {
        "status": {"type": "string", "enum": ["pass", "warn", "fail"]},
        "low": {"type": "integer", "minimum": 0},
        "medium": {"type": "integer", "minimum": 0},
        "high": {"type": "integer", "minimum": 0}
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "category", "severity", "page", "component", "expected", "observed", "detail", "suggested_fix", "scope"],
        "properties": {
          "id": {"type": "string"},
          "category": {"type": "string"},
          "severity": {"type": "string", "enum": ["low", "medium", "high"]},
          "page": {},
          "component": {},
          "expected": {},
          "observed": {},
          "detail": {"type": "string"},
          "suggested_fix": {"type": "string"},
          "scope": {"type": "string", "enum": ["source", "rendered", "pdf", "layout"]}
        }
      }
    },
    "measurement": {"type": "object"},
    "scope_note": {"type": "string"},
    "build_fingerprint": {},
    "pdf_sha256": {}
  }
}
