{
  "schema": "bookorder/publication-architecture-vocabulary@1",
  "note": "Single source of truth for the intent-driven publication architecture. Read by the Python job scripts (scripts/publication_architecture.py, scripts/source_roles.py, scripts/bibliography.py, scripts/editorial_plan.py, scripts/architecture_qa.py) and by the WebUI (src/architecture.ts). Do not duplicate these lists elsewhere.",
  "structure_modes": {
    "auto": {
      "label": "AUTO",
      "description": "BookOrder infers the publication archetype, block policy, visual policy and chapter architecture from the user's intent and the material. Chapters may differ in structure.",
      "description_ja": "意図と資料から、出版物タイプ・ブロック方針・図表方針・章構成をBookOrderが設計します。章ごとに異なる構成を許可します。"
    },
    "guided": {
      "label": "GUIDED",
      "description": "The user fixes the publication type, block preferences, exercise and visual policy; BookOrder designs chapters inside those constraints.",
      "description_ja": "選んだ出版物タイプ・ブロック方針・問題/図表方針を制約として、その範囲でBookOrderが章を設計します。"
    },
    "fixed": {
      "label": "FIXED",
      "description": "Legacy template behaviour: the profile's chapter-end apparatus is required in every chapter and devices follow the profile counts. Jobs without publication_architecture in project.json run in this mode.",
      "description_ja": "従来のテンプレート動作：プロファイルの章末要素を全章に必須とし、要素数もプロファイルに従います（互換用）。"
    }
  },
  "default_mode": "auto",
  "legacy_mode": "fixed",
