  "intent_signals": [
    {
      "id": "no_exercises",
      "patterns": [
        "(章末|練習|演習|確認|復習|理解度)?問題(は|を|も)?(一切)?(いらない|不要|なし|無し|禁止|付けない|つけない|入れない|載せない|省く)",
        "(演習|クイズ)(は|を)?(いらない|不要|なし|無し|禁止|付けない|入れない)",
        "\\b(no|without|skip)\\b[^.]{0,30}\\b(exercises?|quiz(zes)?|review questions)"
      ],
      "effect": {
        "forbid": [
          "exercises",
          "check_questions",
          "answer_key"
        ],
        "exercise_policy": "none"
      }
    },
    {
      "id": "want_exercises",
      "patterns": [
        "(問題|演習)(と解説|と解答)?(を|も)?(多め|多く|入れ|付け|たくさん|豊富)",
        "問題集|試験対策|国家試験|国試|過去問|模擬試験",
        "exam (prep|preparation)|practice questions"
      ],
      "effect": {
        "prefer": [
          "exercises",
          "answer_key"
        ],
        "exercise_policy": "where_useful"
      }
    },
    {
      "id": "exam_book",
      "patterns": [
        "問題集|試験対策|国家試験|国試|過去問|exam (prep|preparation)"
      ],
      "effect": {
        "archetype": "exam_preparation",
        "exercise_policy": "exam_focused"
      }
    },
    {
      "id": "no_summary",
      "patterns": [
        "(章末)?(の)?(まとめ|要約|サマリー)(は|を)?(いらない|不要|なし|無し|付けない|つけない|入れない|省く)",
        "\\bno (chapter )?summar(y|ies)"
      ],
      "effect": {
        "forbid": [
          "summary",
          "key_points"
        ]
      }
    },
    {
      "id": "no_columns",
      "patterns": [
        "コラム(は|を)?(いらない|不要|なし|無し|入れない|付けない)"
      ],
      "effect": {
        "forbid": [
          "column"
        ]
      }
    },
    {
      "id": "more_cases",
      "patterns": [
        "(ケース|事例|症例|ケーススタディ)(を|は)?(多く|多め|豊富|たくさん|中心|重視|増や)",
        "(many|more) (cases|case studies|examples)"
      ],
      "effect": {
        "prefer": [
          "case_study",
          "clinical_case",
          "case_reflection"
        ],
        "case_emphasis": "high"
      }
    },
    {
      "id": "more_visuals",
      "patterns": [
        "(図表|図解|図|イラスト|ビジュアル)(を|は)?(多く|多め|豊富|たくさん|中心|重視|増や)",
        "visually rich|(many|more) (figures|diagrams|visuals)"
      ],
      "effect": {
        "visual_density": "high"
      }
    },
    {
      "id": "fewer_visuals",
      "patterns": [
        "(図表|図|イラスト)(は)?(少なめ|最小限|控えめ|いらない|不要)"
      ],
      "effect": {
        "visual_density": "low"
      }
    },
    {
      "id": "not_stiff",
      "patterns": [
        "(固|堅|硬)(すぎ|過ぎ)(ない|ず)",
        "(やわらか|柔らか|親しみやす|カジュアル|くだけ)",
        "not too (formal|stiff)"
      ],
      "effect": {
        "tone": "approachable, not stiff"
      }
    },
    {
      "id": "no_textbook",
      "patterns": [
        "教科書(的|っぽ)(に|く)?(しない|せず|ない|はしない)"
      ],
      "effect": {
        "discourage": [
          "summary",
          "key_points",
          "exercises",
          "check_questions"
        ]
      }
    },
    {
      "id": "more_checklists",
      "patterns": [
        "チェックリスト(を|は)?(多く|多め|入れ|付け|中心|重視)"
      ],
      "effect": {
        "prefer": [
          "checklist"
        ]
      }
    },
    {
      "id": "practical_use",
      "patterns": [
        "(現場|実務|臨床|業務|病棟)(で|に|の)(すぐ)?(使える|役立つ|役に立つ)|実務(ガイド|書)|マニュアル"
      ],
      "effect": {
        "archetype": "practical_guide"
      }
    },
    {
      "id": "textbook_use",
      "patterns": [
        "教科書として|テキストとして|講義(で|用)|授業(で|用)"
      ],
      "effect": {
        "archetype": "textbook"
      }
    },
    {
      "id": "visual_guide",
      "patterns": [
