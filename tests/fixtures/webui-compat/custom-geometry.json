      "size": "A5",
      "orientation": "portrait"
    },
    "layout": {
      "density": "standard"
    },
    "colors": {
      "accent": "#0891B2"
    },
    "typography": {
      "body": {
        "japanese": "Noto Serif CJK JP",
        "latin": "Source Serif 4",
        "size": "9.5pt",
        "weight": 400
      },
      "heading": {
        "japanese": "Noto Sans JP",
        "latin": "Inter",
        "weight": 700
      },
      "code": {
        "latin": "JetBrains Mono",
        "size": "8.3pt"
      },
      "caption": {
        "family": "Noto Sans JP",
        "size": "7.8pt"
      },
      "footnote": {
