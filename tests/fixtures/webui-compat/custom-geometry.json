{
  "project": {
    "format": "portable-publishing-job",
    "format_version": "0.2",
    "book": {
      "title": "Compat",
      "description": "Goal",
      "target_readers": "Readers",
      "target_pages": 150,
      "language": "ja"
    },
    "user_instructions": "",
    "research": {
      "allow_web_research": true,
      "prefer_primary_sources": true,
      "keep_provenance": true,
      "require_supplied_coverage": true
    },
    "figures": {
      "tables": true,
      "diagrams": true,
      "charts": true,
      "generative_images": false
    },
    "citations": {
      "style": "numeric"
    },
    "outputs": {
      "canonical_markdown": true,
      "docx": true,
      "semantic_html": true,
      "pdf": true,
      "static_site": true,
      "epub": false
    },
    "runtime": {
      "target": "none",
      "bundled": false
    },
    "design": {
      "spec": "book.design.yaml",
      "theme": "modern-technical",
      "custom_css": "custom.css"
    },
    "input": {
      "urls": [],
      "sources": []
    },
    "layout_spec": {
      "page_size": "custom",
      "orientation": "portrait",
      "writing_mode": "horizontal-tb",
      "page": {
        "margin_top_mm": 18,
        "margin_bottom_mm": 20,
        "margin_inner_mm": 20,
        "margin_outer_mm": 16,
        "width_mm": 182,
        "height_mm": 257
      },
      "body": {
        "columns": 2,
        "gutter_mm": 6
      },
      "span_policy": {
        "figure": "auto",
        "table": "full"
      }
    }
  },
  "design": {
    "$schema": "schemas/design.schema.json",
    "theme": "modern-technical",
    "art_direction": "",
