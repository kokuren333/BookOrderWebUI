  },
  "dependencies": { "jszip": "^3.10.1", "react": "^19.1.1", "react-dom": "^19.1.1" },
  "devDependencies": { "@types/react": "^19.1.16", "@types/react-dom": "^19.1.9", "typescript": "^5.9.2", "vite": "^7.1.7" }
}
