{
  "name": "portable-publishing-job-generator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "prepare:runtimes": "python tools/prepare-runtimes.py",
